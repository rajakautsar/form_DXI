# .htaccess - Allow all access for dev tunnel & local
# Form DXI - Competition Registration System

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Allow ALL access (for localhost, IP, dev tunnel)
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Alternative for Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Prevent directory listing
Options -Indexes

# Set charset
AddDefaultCharset UTF-8

# CORS headers for dev tunnel & remote access
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
